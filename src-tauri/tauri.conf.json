{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beelauncher",
  "version": "0.1.0",
  "identifier": "gg.tenbeee.beelauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Beelauncher",
        "width": 1000,
        "height": 640,
        "minWidth": 800,
        "minHeight": 520,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
